# Backend base URL (no trailing slash)
VITE_API_URL=http://localhost:8000
# Optional: Google Maps JS API key (Maps + Places). Without it, OpenStreetMap/Leaflet is used.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: Firebase Cloud Messaging (push notifications). Leave blank to disable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Optional: Google AdSense publisher id (ca-pub-xxxx). Without it, the built-in ad server is used.
VITE_ADSENSE_CLIENT=
